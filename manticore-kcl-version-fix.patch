diff --git a/windows/keycredentiallink/version/KeyCredentialLinkVersion.go b/windows/keycredentiallink/version/KeyCredentialLinkVersion.go
index 251c281f..3457b6e5 100644
--- a/windows/keycredentiallink/version/KeyCredentialLinkVersion.go
+++ b/windows/keycredentiallink/version/KeyCredentialLinkVersion.go
@@ -23,7 +23,15 @@ const (
 //
 // Parameters:
 // - value: A byte array representing the KeyCredentialLinkVersion.
+//
+// Returns:
+// - The number of bytes read (4 on success).
+// - An error if value is shorter than 4 bytes.
 func (kcv *KeyCredentialLinkVersion) Unmarshal(value []byte) (int, error) {
+	if len(value) < 4 {
+		return 0, fmt.Errorf("data too short to unmarshal KeyCredentialLinkVersion: have %d bytes, need 4", len(value))
+	}
+
 	kcv.RawBytes = value[:4]
 	kcv.RawBytesSize = 4
 
diff --git a/windows/keycredentiallink/version/KeyCredentialLinkVersion_test.go b/windows/keycredentiallink/version/KeyCredentialLinkVersion_test.go
index 4d9b5e35..c9cf2f2a 100644
--- a/windows/keycredentiallink/version/KeyCredentialLinkVersion_test.go
+++ b/windows/keycredentiallink/version/KeyCredentialLinkVersion_test.go
@@ -75,3 +75,26 @@ func TestKeyCredentialLinkVersion_Marshal(t *testing.T) {
 		})
 	}
 }
+
+func TestKeyCredentialLinkVersion_Unmarshal_TooShort(t *testing.T) {
+	inputs := [][]byte{
+		nil,
+		{},
+		{0x00},
+		{0x00, 0x02},
+		{0x00, 0x02, 0x00},
+	}
+
+	for _, input := range inputs {
+		t.Run(fmt.Sprintf("len=%d", len(input)), func(t *testing.T) {
+			var kcv version.KeyCredentialLinkVersion
+			bytesRead, err := kcv.Unmarshal(input)
+			if err == nil {
+				t.Errorf("Expected an error for a %d-byte input, but got nil", len(input))
+			}
+			if bytesRead != 0 {
+				t.Errorf("Expected 0 bytes read, but got %d", bytesRead)
+			}
+		})
+	}
+}
